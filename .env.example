# ===== Backend (copy to .env at the repo root; NEVER commit .env) =====
# Generate a secret:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to send state-changing requests (must match the address you open the frontend on)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production only (DJANGO_DEBUG=False): HTTPS redirect is on by default; set False only behind a proxy that already redirects.
# DJANGO_SECURE_SSL_REDIRECT=True

# PostgreSQL
DB_NAME=coastshield
DB_USER=coastshield
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Rate limits (DRF format: N/min, N/hour)
RATE_LIMIT_LOGIN=5/min
RATE_LIMIT_REGISTER=10/hour
RATE_LIMIT_ORDER_SUBMIT=10/min
RATE_LIMIT_ORDER_LOOKUP=10/min
RATE_LIMIT_ANALYSIS=20/min
RATE_LIMIT_UPLOAD=20/hour
# Days to keep security-check history (outcomes only, never the checked text); users can also delete it any time
ANALYSIS_RETENTION_DAYS=90
MAX_UPLOAD_MB=2

# ===== Frontend: put these in frontend/.env (see frontend/.env.example) =====
# VITE_DATA_MODE=api
