# Frontend environment (copy to frontend/.env)
# "demo": browser-only mock with sample data (no backend needed, NOT secure)
# "api":  the Django backend (run it on :8000; Vite proxies /api to it)
VITE_DATA_MODE=demo
VITE_API_BASE_URL=/api/v1
# Show the "Use sample account" button when running against a backend seeded with `python manage.py seed_demo`
VITE_SHOW_SAMPLE_LOGIN=false
